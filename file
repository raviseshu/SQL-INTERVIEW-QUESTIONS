-- Q65: Calculate a running total of sales for each salesman ordered by sale date.
SELECT 
    salesman_id, sale_date, amount,
    SUM(amount) OVER (PARTITION BY salesman_id ORDER BY sale_date) AS running_total
FROM sales_tracker;


-- Q66: Calculate a 3-day moving average of sales amounts for each salesman.
SELECT 
    salesman_id, sale_date, amount,
    AVG(amount) OVER (
        PARTITION BY salesman_id 
        ORDER BY sale_date 
        ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
    ) AS moving_avg_3day
FROM sales_tracker;


-- Q67: Find the percentage contribution of each employee's salary to their department's total payroll.
SELECT 
    empid, dept_id, salary,
    (salary * 100.0) / SUM(salary) OVER(PARTITION BY dept_id) AS pct_contribution
FROM employees;


-- Q68: Retrieve the details of the employee who was hired immediately before and after each employee.
SELECT 
    first_name, hire_date,
    LAG(first_name) OVER (ORDER BY hire_date) AS hired_just_before,
    LEAD(first_name) OVER (ORDER BY hire_date) AS hired_just_after
FROM employees;



-- Q69: Compare an employee's salary directly against the average salary of their respective department.
SELECT 
    first_name, dept_id, salary,
    AVG(salary) OVER(PARTITION BY dept_id) AS deviation_from_dept_avg
FROM employees;

-- Q69: Compare an employee's salary directly against the average salary of their respective department.
SELECT 
    first_name, dept_id, salary,
    salary - AVG(salary) OVER(PARTITION BY dept_id) AS deviation_from_dept_avg
FROM employees;


-- Q70: Find the first and last employee hired within each department without sorting the final display by date.
SELECT DISTINCT 
    dept_id,
    FIRST_VALUE(first_name) OVER(PARTITION BY dept_id ORDER BY hire_date ASC) AS first_hired,
    LAST_VALUE(first_name) OVER(PARTITION BY dept_id ORDER BY hire_date ASC 
        ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS last_hired
FROM employees
WHERE dept_id IS NOT NULL;


-- Q71: Segment employees into 3 separate salary tiers (High, Medium, Low) per department using NTILE.
SELECT 
    first_name, dept_id, salary,
    NTILE(3) OVER(PARTITION BY dept_id ORDER BY salary DESC) AS salary_tier
FROM employees;


-- Q72: Find the exact difference in sales amount between the current sale and the previous highest sale for that salesman.
SELECT 
    salesman_id, sale_date, amount,
    amount - LAG(amount) OVER(PARTITION BY salesman_id ORDER BY amount ASC) AS diff_from_prev_highest
FROM sales_tracker;


-- Q73: Write a query to identify if a salesman's revenue dropped compared to their immediate prior sale. 
SELECT salesman_id, sale_date, amount,
    CASE WHEN amount < LAG(amount) OVER(PARTITION BY salesman_id ORDER BY sale_date) 
         THEN 'Revenue Dropped' ELSE 'Maintained/Increased' END AS performance_trend
FROM sales_tracker;


