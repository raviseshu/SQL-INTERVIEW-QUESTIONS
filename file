-- Q111: Correlated Subquery vs EXISTS - Fetch departments that contain at least one person making > 80,000.
-- Why optimized: EXISTS terminates evaluation instantly upon matching the first true occurrence (Short-circuit evaluation).
SELECT d.dept_name 
FROM departments d
WHERE EXISTS (
    SELECT 1 FROM employees e 
    WHERE e.dept_id = d.dept_id AND e.salary > 80000
);


-- Q112: Illustrate the processing danger of using 'NOT IN' against a subquery that could potentially evaluate a NULL value.
-- Why optimized: If the subquery yields even a single NULL, 'NOT IN' returns an empty set. 'NOT EXISTS' safely mitigates this risk.
SELECT * FROM departments 
WHERE dept_id NOT IN (SELECT DISTINCT dept_id FROM employees WHERE dept_id IS NOT NULL);


