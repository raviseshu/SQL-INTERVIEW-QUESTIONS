-- Q81: Static Pivot Matrix - Convert row-based quarterly sales data into distinct columns.
SELECT 
    salesman_id,
    SUM(CASE WHEN quarter = 'Q1' THEN amount ELSE 0 END) AS Q1_Sales,
    SUM(CASE WHEN quarter = 'Q2' THEN amount ELSE 0 END) AS Q2_Sales
FROM sales_tracker
GROUP BY salesman_id;


-- Q82: Reverse Pivot (Unpivot) emulation using standard UNION ALL structure.
-- Useful when taking multi-column balance sheets and turning them back into dynamic data feeds.
SELECT salesman_id, 'Q1' AS Quarter, Q1_Sales AS Amount FROM (SELECT salesman_id, SUM(CASE WHEN quarter = 'Q1' THEN amount ELSE 0 END) AS Q1_Sales FROM sales_tracker GROUP BY salesman_id) AS src
UNION ALL
SELECT salesman_id, 'Q2' AS Quarter, Q2_Sales AS Amount FROM (SELECT salesman_id, SUM(CASE WHEN quarter = 'Q2' THEN amount ELSE 0 END) AS Q2_Sales FROM sales_tracker GROUP BY salesman_id) AS src;


-- Q83: Conditionally concatenate all employee first names belonging to the same department into a single comma-separated string.
