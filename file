-- Q96: Gaps and Islands Problem - Find the user_id and start/end dates of consecutive multi-day login streaks.
WITH LoginGroups AS (
    SELECT 
        user_id, login_date,
        DATEADD(day, -ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY login_date), login_date) AS streak_group
    FROM login_history
)
SELECT 
    user_id,
    MIN(login_date) AS streak_start_date,
    MAX(login_date) AS streak_end_date,
    DATEDIFF(day, MIN(login_date), MAX(login_date)) + 1 AS consecutive_days
FROM LoginGroups
GROUP BY user_id, streak_group;


-- Q97: Recursive CTE (Hierarchical Query) - Generate an organizational chart displaying management levels from CEO downward.
WITH OrgChartRecursive AS (
    -- Anchor Member: Find the ultimate boss (manager_id IS NULL)
    SELECT empid, first_name, manager_id, 1 AS org_level
    FROM employees
    WHERE manager_id IS NULL
    
    UNION ALL
    
    -- Recursive Member: Join remaining employees back to their respective managers
    SELECT e.empid, e.first_name, e.manager_id, r.org_level + 1
    FROM employees e
    INNER JOIN OrgChartRecursive r ON e.manager_id = r.empid
)
SELECT empid, first_name, manager_id, org_level 
FROM OrgChartRecursive
ORDER BY org_level, manager_id;


-- Q98: Identify orphans/missing references in tables without relying explicitly on declared foreign key triggers.
SELECT e.empid, e.dept_id
FROM employees e
WHERE NOT EXISTS (
    SELECT 1 FROM departments d WHERE d.dept_id = e.dept_id
) AND e.dept_id IS NOT NULL;


-- Q99: Find the absolute median salary within each department without leveraging distinct native MEDIAN() formulas.
WITH OrderedSalaries AS (
    SELECT dept_id, salary,
           ROW_NUMBER() OVER (PARTITION BY dept_id ORDER BY salary ASC) AS row_num,
           COUNT(*) OVER (PARTITION BY dept_id) AS total_count
    FROM employees
    WHERE dept_id IS NOT NULL
)
SELECT dept_id, AVG(salary * 1.0) AS median_salary
FROM OrderedSalaries
WHERE row_num IN ((total_count + 1) / 2, (total_count + 2) / 2)
GROUP BY dept_id;


